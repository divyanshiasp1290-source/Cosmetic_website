{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/booking", "destination": "/__server/api/booking" },
    { "source": "/api/availability", "destination": "/__server/api/availability" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}
